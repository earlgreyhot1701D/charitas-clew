# ==============================================================================
# Charitas Clew Environment Configuration Template
# ==============================================================================
# Copy this file to .env and supply your Google Gemini API key:
#   cp .env.example .env
#
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# ==============================================================================

# Required: Google Gemini API key for multimodal document parsing and deconstruction
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Port for local Express development server (defaults to 8080)
PORT=8080
